<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Lost Reports</title>
</head>

<body>
    <h1>My Lost Reports</h1>
    <a href="/report/lost">Report Another Lost Item</a>
    <br><br>
    <% if (reports.length===0) { %>

        <p>You haven't reported any lost items yet.</p>

        <% } else { %>
            <% reports.forEach(report=> { %>
                <article>
                    <h2>
                        <%= report.item_name %>
                    </h2>
                    <p><strong>Category:</strong>
                        <%= report.category_name %>
                    </p>
                    <p><strong>Description:</strong>
                        <%= report.description %>
                    </p>
                    <p><strong>Date Lost:</strong>
                        <%= report.date_lost %>
                    </p>
                    <p><strong>Location:</strong>
                        <%= report.location %>
                    </p>
                    <p><strong>Status:</strong>
                        <%= report.status %>
                    </p>
                    <hr>
                </article>
                <% }) %>
                    <% } %>

                        <a href="/dashboard">Back to Dashboard</a>
</body>

</html>